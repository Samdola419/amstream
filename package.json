{
  "name": "aniestream",
  "version": "1.0.0",
  "private": true,
  "description": "AnimeStream desktop window",
  "author": "AnimeStream",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "app.vercel.aniestream",
    "productName": "AnimeStream",
    "directories": { "output": "dist" },
    "files": ["main.js"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
